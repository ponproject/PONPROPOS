                </span>
            `).join('');
        }

        function addDiscountPreset() {
            const nameInp = document.getElementById('new-discount-preset-name');
            const inp = document.getElementById('new-discount-preset-input');
            const name = (nameInp?.value || '').trim();
            const val = Number(inp?.value);
            if (!val || val <= 0) {
                showToast('Masukkan nominal diskon yang valid', 'warning');
                return;
            }
            if (!state.discountPresets[state.currency]) state.discountPresets[state.currency] = [];
            state.discountPresets[state.currency].push({ name, amount: val });
            state.discountPresets[state.currency].sort((a, b) => a.amount - b.amount);
            if (nameInp) nameInp.value = '';
            if (inp) inp.value = '';
            saveState();
            renderSettingsDiscountPresets();
            renderQuickDiscountButtons();
            showToast(`Preset diskon "${name || formatCurrency(val)}" ditambahkan`);
        }

        function removeDiscountPreset(idx) {
            if (!state.discountPresets[state.currency]) return;
            state.discountPresets[state.currency].splice(idx, 1);
            saveState();
            renderSettingsDiscountPresets();
            renderQuickDiscountButtons();
        }

        function resetDefaultDiscountPresets() {
            state.discountPresets[state.currency] = JSON.parse(JSON.stringify(DEFAULT_DISCOUNT_PRESETS[state.currency]));
            saveState();
            renderSettingsDiscountPresets();
            renderQuickDiscountButtons();
            showToast('Preset diskon dikembalikan ke default');
