        function renderQuickCashButtons(grandTotal) {
            const container = document.getElementById('quick-cash-buttons');
            if (!container) return;
            if (grandTotal <= 0) {
                container.innerHTML = '';
                return;
            }
            const suggestions = new Set([grandTotal]);
            if (state.currency === 'IDR') {
                [50000, 100000, 150000, 200000, 300000, 500000, 1000000].forEach(n => {
                    if (n >= grandTotal && suggestions.size < 4) suggestions.add(n);
                });
            } else {
                [10, 20, 50, 100, 200, 500].forEach(n => {
                    if (n >= grandTotal && suggestions.size < 4) suggestions.add(n);
                });
            }
            container.innerHTML = Array.from(suggestions).map((val, idx) => `
                <button type="button" onclick="setCashTendered(${val})" class="px-2 py-1 rounded-lg bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-[10px] font-mono font-bold text-zinc-700 dark:text-zinc-200">
                    ${idx === 0 ? 'Uang Pas' : formatCurrency(val)}
                </button>
            `).join('');
        }

        function setCashTendered(amount) {
            const inp = document.getElementById('cash-tendered-input');
            if (inp) inp.value = amount;
            calculateChange();
        }

        function calculateChange() {
            const { grandTotal } = getCartTotals();
            const rawVal = document.getElementById('cash-tendered-input')?.value;
            const tendered = rawVal === '' || rawVal === null ? grandTotal : (Number(rawVal) || 0);
            const change = Math.max(0, tendered - grandTotal);
            const display = document.getElementById('cash-change-display');
            if (display) {
                if (rawVal !== '' && tendered < grandTotal) {
                    display.textContent = `Kurang ${formatCurrency(grandTotal - tendered)}`;
                    display.className = 'font-mono font-extrabold text-rose-600 dark:text-rose-400';
                } else {
                    display.textContent = formatCurrency(change);
                    display.className = 'font-mono font-extrabold text-emerald-600 dark:text-emerald-400';
                }
            }
        }

        function processCheckout() {
            if (state.cart.length === 0) {
                showToast('Keranjang masih kosong!', 'warning');
                return;
            }
            for (const item of state.cart) {
                const prod = state.products.find(p => p.id === item.id);
                if (!prod || prod.stock < item.qty) {
                    showToast(`Stok ${item.name} (${item.size}) tidak mencukupi!`, 'error');
                    return;
                }
            }

            const { subtotal, discount, discountName, grandTotal } = getCartTotals();
            const rawTendered = document.getElementById('cash-tendered-input')?.value;
            const tendered = state.paymentMethod === 'Cash'
                ? (rawTendered === '' ? grandTotal : (Number(rawTendered) || 0))
                : grandTotal;

            if (state.paymentMethod === 'Cash' && tendered < grandTotal) {
                showToast('Uang tunai diterima kurang dari total bayar!', 'error');
                return;
            }

            let totalHpp = 0;
            const txItems = state.cart.map(item => {
                const prod = state.products.find(p => p.id === item.id);
                if (prod) prod.stock = Math.max(0, prod.stock - item.qty);
                const hppUnit = Number(prod?.hpp ?? item.hpp) || 0;
                totalHpp += hppUnit * item.qty;
                return {
                    id: item.id,
                    name: item.name,
                    size: item.size,
                    price: item.price,
                    hpp: hppUnit,
                    qty: item.qty
                };
            });

            const tx = {
                id: `TRX-${Date.now().toString().slice(-6)}`,
                timestamp: new Date().toISOString(),
                items: txItems,
                subtotal,
                discount,
                discountName,
                total: grandTotal,
                totalHpp,
                profit: grandTotal - totalHpp,
                paymentMethod: state.paymentMethod,
                tendered,
                change: state.paymentMethod === 'Cash' ? Math.max(0, tendered - grandTotal) : 0
            };

            state.transactions.unshift(tx);
            clearCart();
            saveState();
            renderAll();
            showReceiptModal(tx);
            showToast(`Transaksi ${tx.id} berhasil disimpan!`);
        }

