        function loadState() {
            try {
                const raw = localStorage.getItem('ponpro_pos_state_v1');
                if (!raw) {
                    state.products = JSON.parse(JSON.stringify(INITIAL_PRODUCTS));
                    return;
                }
                const parsed = JSON.parse(raw);
                state.currency = CURRENCY_CONFIG[parsed.currency] ? parsed.currency : 'IDR';
                state.products = Array.isArray(parsed.products) ? parsed.products : JSON.parse(JSON.stringify(INITIAL_PRODUCTS));
                state.cart = Array.isArray(parsed.cart) ? parsed.cart : [];
                state.transactions = Array.isArray(parsed.transactions) ? parsed.transactions : [];
                state.pendingOrders = Array.isArray(parsed.pendingOrders) ? parsed.pendingOrders : [];
                state.opnameLogs = Array.isArray(parsed.opnameLogs) ? parsed.opnameLogs : [];
                state.discountAutoSave = parsed.discountAutoSave !== undefined ? !!parsed.discountAutoSave : true;
                state.discountValue = state.discountAutoSave ? (Number(parsed.discountValue) || 0) : 0;
                state.discountName = state.discountAutoSave ? (parsed.discountName || '') : '';
                state.discountPresets = normalizeDiscountPresets(parsed.discountPresets);
                state.paymentMethod = parsed.paymentMethod || 'Cash';
                state.reportPngTheme = parsed.reportPngTheme || 'light';
                state.storeProfile = { ...DEFAULT_STORE_PROFILE, ...(parsed.storeProfile || {}) };
            } catch (e) {
                console.error('Failed to load state:', e);
                state.products = JSON.parse(JSON.stringify(INITIAL_PRODUCTS));
            }
        }

        function saveState() {
            try {
                localStorage.setItem('ponpro_pos_state_v1', JSON.stringify({
                    currency: state.currency,
                    products: state.products,
                    cart: state.cart,
                    transactions: state.transactions,
                    pendingOrders: state.pendingOrders,
                    opnameLogs: state.opnameLogs,
                    discountValue: state.discountValue,
                    discountName: state.discountName,
                    discountAutoSave: state.discountAutoSave,
                    discountPresets: state.discountPresets,
                    paymentMethod: state.paymentMethod,
                    reportPngTheme: state.reportPngTheme,
                    storeProfile: state.storeProfile
                }));
            } catch (e) {
                console.error('Failed to save state:', e);
            }
        }

        // =====================================================================
        // 3. UTILITIES, NAVIGATION & CURRENCY FORMATTING
        // =====================================================================
        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatCurrency(amount) {
            const cfg = CURRENCY_CONFIG[state.currency] || CURRENCY_CONFIG.IDR;
            const num = Number(amount) || 0;
            const formatted = num.toLocaleString(cfg.locale, {
                minimumFractionDigits: cfg.decimals,
                maximumFractionDigits: cfg.decimals
            });
            return `${cfg.symbol} ${formatted}`;
        }

        function syncCurrencyUI() {
            const cfg = CURRENCY_CONFIG[state.currency] || CURRENCY_CONFIG.IDR;
            const headerEl = document.getElementById('active-curr-header');
            if (headerEl) headerEl.textContent = `${cfg.code} (${cfg.symbol})`;
            document.querySelectorAll('.curr-symbol').forEach(el => el.textContent = cfg.symbol);
            document.querySelectorAll('.active-curr-code').forEach(el => el.textContent = cfg.code);

            ['IDR', 'SGD', 'MYR'].forEach(code => {
                const btn = document.getElementById(`set-curr-${code}`);
                if (!btn) return;
                if (code === state.currency) {
                    btn.className = 'set-curr-btn p-3 rounded-xl border-2 border-zinc-900 dark:border-white aurora-pill text-center transition-all shadow-sm';
                } else {
                    btn.className = 'set-curr-btn p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-center opacity-75 hover:opacity-100 transition-all';
