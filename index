    <script>
        // =====================================================================
        // 1. PWA ICON GENERATOR & BRAND LOGO
        // =====================================================================
        function initPwaAndBrandLogo() {
            try {
                const createLogoDataUrl = (size) => {
                    const c = document.createElement('canvas');
                    c.width = size;
                    c.height = size;
                    const ctx = c.getContext('2d');

                    const grad = ctx.createLinearGradient(0, 0, size, size);
                    grad.addColorStop(0, '#09090b');
                    grad.addColorStop(0.55, '#18181b');
                    grad.addColorStop(1, '#27272a');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.roundRect(0, 0, size, size, size * 0.22);
                    ctx.fill();

                    const aura = ctx.createRadialGradient(size * 0.8, size * 0.2, 0, size * 0.8, size * 0.2, size * 0.75);
                    aura.addColorStop(0, 'rgba(56, 189, 248, 0.45)');
                    aura.addColorStop(0.5, 'rgba(16, 185, 129, 0.25)');
                    aura.addColorStop(1, 'transparent');
                    ctx.fillStyle = aura;
                    ctx.fillRect(0, 0, size, size);

                    ctx.fillStyle = '#ffffff';
                    ctx.font = `900 ${Math.round(size * 0.34)}px Inter, sans-serif`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText('PP', size * 0.5, size * 0.46);

                    ctx.fillStyle = '#38bdf8';
                    ctx.font = `800 ${Math.round(size * 0.13)}px "JetBrains Mono", monospace`;
                    ctx.fillText('POS', size * 0.5, size * 0.74);

                    return c.toDataURL('image/png');
                };

                const icon192 = createLogoDataUrl(192);
                const icon512 = createLogoDataUrl(512);

                const appleLink = document.getElementById('apple-touch-icon-link');
                const favLink = document.getElementById('favicon-link');
                const manifestLink = document.getElementById('pwa-manifest-link');

                if (appleLink) appleLink.href = icon192;
                if (favLink) favLink.href = icon192;

                if (manifestLink) {
                    const manifest = {
                        name: 'PONPRO POS — Kasir & Stok Opname',
                        short_name: 'PONPRO POS',
                        start_url: '.',
                        display: 'standalone',
                        background_color: '#09090b',
                        theme_color: '#09090b',
                        icons: [
                            { src: icon192, sizes: '192x192', type: 'image/png' },
                            { src: icon512, sizes: '512x512', type: 'image/png' }
                        ]
                    };
                    const blob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
                    manifestLink.href = URL.createObjectURL(blob);
                }
            } catch (err) {
                console.warn('PWA init skipped:', err);
            }
        }

        // =====================================================================
        // 2. DATA MODEL, CURRENCY CONFIG & LOCAL STORAGE
        // =====================================================================
        const CURRENCY_CONFIG = {
            IDR: { code: 'IDR', symbol: 'Rp', locale: 'id-ID', decimals: 0 },
            SGD: { code: 'SGD', symbol: 'S$', locale: 'en-SG', decimals: 2 },
            MYR: { code: 'MYR', symbol: 'RM', locale: 'ms-MY', decimals: 2 }
        };

        const DEFAULT_DISCOUNT_PRESETS = {
            IDR: [
                { name: 'Promo Hemat', amount: 10000 },
                { name: 'Promo Event', amount: 20000 },
                { name: 'Diskon Spesial', amount: 50000 },
                { name: 'VIP Voucher', amount: 100000 }
            ],
            SGD: [
                { name: 'Promo', amount: 2 },
                { name: 'Event Deal', amount: 5 },
                { name: 'Special Disc', amount: 10 },
                { name: 'VIP Voucher', amount: 20 }
            ],
            MYR: [
                { name: 'Promo', amount: 5 },
                { name: 'Event Deal', amount: 10 },
                { name: 'Special Disc', amount: 20 },
                { name: 'VIP Voucher', amount: 50 }
            ]
        };

        function normalizeDiscountPresets(rawPresets) {
            const normalized = {};
            ['IDR', 'SGD', 'MYR'].forEach(curr => {
                const list = Array.isArray(rawPresets?.[curr]) ? rawPresets[curr] : DEFAULT_DISCOUNT_PRESETS[curr];
                normalized[curr] = list.map(item => {
                    if (typeof item === 'number') {
                        return { name: '', amount: item };
                    }
                    return {
                        name: String(item?.name || '').trim(),
                        amount: Math.max(0, Number(item?.amount) || 0)
                    };
                }).filter(it => it.amount > 0);
            });
            return normalized;
        }

