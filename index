        async function shareReportNative() {
            const canvas = document.getElementById('share-report-canvas');
            if (!canvas) return;
            try {
                const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
                const file = new File([blob], 'Laporan_PONPRO_POS.png', { type: 'image/png' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({
                        title: 'Laporan Penjualan PONPRO POS',
                        text: 'Ringkasan laporan penjualan dari PONPRO POS',
                        files: [file]
                    });
                } else {
                    downloadReportPng();
                }
            } catch (err) {
                if (err.name !== 'AbortError') downloadReportPng();
            }
        }

