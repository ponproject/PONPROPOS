        function buildReceiptPlainText(tx) {
            const prof = state.storeProfile || DEFAULT_STORE_PROFILE;
            const lines = [
                `*${prof.name || 'PONPRO POS'}*`,
                prof.address || '',
                `No. Nota: #${tx.id}`,
                `Waktu: ${new Date(tx.timestamp).toLocaleString('id-ID')}`,
                '--------------------------------',
                ...tx.items.map(i => `• ${i.name} (${i.size}) x${i.qty} = ${formatCurrency(i.price * i.qty)}`),
                '--------------------------------',
                `Subtotal: ${formatCurrency(tx.subtotal)}`,
                tx.discount > 0 ? `Diskon${tx.discountName ? ` (${tx.discountName})` : ''}: -${formatCurrency(tx.discount)}` : null,
                `*TOTAL BAYAR: ${formatCurrency(tx.total)}*`,
                `Metode: ${tx.paymentMethod}`,
                '',
                prof.footer || 'Terima kasih telah berbelanja!'
            ].filter(Boolean);
            return lines.join('\n');
        }

