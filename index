<!DOCTYPE html>
<html lang="id" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PONPRO POS — Kasir & Stok Opname</title>
    <!-- PWA & Mobile App Metadata -->
    <meta name="theme-color" content="#09090b">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="PONPRO POS">
    <link id="apple-touch-icon-link" rel="apple-touch-icon">
    <link id="favicon-link" rel="icon" type="image/png">
    <link id="pwa-manifest-link" rel="manifest">
    <!-- Tailwind CSS -->
