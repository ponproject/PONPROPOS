        function openConfirmModal(title, message, onConfirm) {
            document.getElementById('confirm-title').textContent = title;
            document.getElementById('confirm-message').textContent = message;
            const yesBtn = document.getElementById('confirm-yes-btn');
            yesBtn.onclick = () => {
                closeConfirmModal();
                if (typeof onConfirm === 'function') onConfirm();
            };
            document.getElementById('confirm-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeConfirmModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
        }

        function openResetConfirmModal() {
            openConfirmModal(
                'Reset Semua Data Lokal?',
                'Seluruh riwayat transaksi, log stok opname, dan perubahan stok akan dihapus dan dikembalikan ke data awal.',
                () => {
                    localStorage.removeItem('ponpro_pos_state_v1');
                    state.products = JSON.parse(JSON.stringify(INITIAL_PRODUCTS));
                    state.cart = [];
                    state.transactions = [];
                    state.pendingOrders = [];
                    state.opnameLogs = [];
                    state.discountValue = 0;
                    state.discountName = '';
                    state.selectedInventoryIds = [];
                    saveState();
                    renderAll();
                    showToast('Seluruh data berhasil direset ke awal');
                }
            );
        }

        // =====================================================================
        // 11. INITIALIZATION
        // =====================================================================
        function renderAll() {
            syncCurrencyUI();
            const discInput = document.getElementById('cart-discount-value');
            if (discInput) discInput.value = state.discountValue || 0;
            const autoSaveCb = document.getElementById('discount-autosave-toggle');
            if (autoSaveCb) autoSaveCb.checked = !!state.discountAutoSave;
            const savedBadge = document.getElementById('discount-saved-badge');
            if (savedBadge) savedBadge.classList.toggle('hidden', !state.discountAutoSave);

            selectPaymentMethod(state.paymentMethod || 'Cash');
            renderPosCatalog();
            renderCart();
            renderCekStok();
            renderInventoryTable();
            renderOpnameHistory();
            renderReports();
            lucide.createIcons();
        }

        window.onload = function () {
            if (localStorage.getItem('ponpro_theme') === 'dark') {
                document.documentElement.classList.add('dark');
            }
            initPwaAndBrandLogo();
            loadState();
            renderAll();
        };
    </script>
</body>
</html>
