    <style>
        /* Clean Light & Monochrome Aurora Gradations */
        .bg-clean-light {
            background: radial-gradient(circle at 12% 8%, rgba(56, 189, 248, 0.08) 0%, transparent 42%),
                        radial-gradient(circle at 88% 12%, rgba(168, 85, 247, 0.08) 0%, transparent 45%),
                        radial-gradient(circle at 50% 90%, rgba(16, 185, 129, 0.06) 0%, transparent 50%),
                        linear-gradient(180deg, #ffffff 0%, #f8fafc 45%, #f1f5f9 100%);
        }
        .dark .bg-clean-light {
            background: radial-gradient(circle at 15% 10%, rgba(56, 189, 248, 0.09) 0%, transparent 40%),
                        radial-gradient(circle at 85% 15%, rgba(168, 85, 247, 0.09) 0%, transparent 45%),
                        linear-gradient(180deg, #09090b 0%, #0f172a 55%, #020617 100%);
        }
        .bg-mono-gradient {
            background: linear-gradient(135deg, #09090b 0%, #27272a 55%, #3f3f46 100%);
        }
        .dark .bg-mono-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #e4e4e7 60%, #a1a1aa 100%);
        }
        .bg-aurora-accent {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.14) 0%, rgba(56, 189, 248, 0.14) 50%, rgba(168, 85, 247, 0.14) 100%);
        }
        .aurora-pill {
            background: linear-gradient(120deg, #f0fdf4 0%, #f0f9ff 50%, #faf5ff 100%);
        }
        .dark .aurora-pill {
            background: linear-gradient(120deg, rgba(16, 185, 129, 0.12) 0%, rgba(56, 189, 248, 0.12) 50%, rgba(168, 85, 247, 0.12) 100%);
        }
        /* Glassmorphism Aurora Cards */
        .glass-aurora-card {
            background: linear-gradient(135deg, rgba(209, 250, 229, 0.72) 0%, rgba(224, 242, 254, 0.78) 48%, rgba(243, 232, 255, 0.82) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(125, 211, 252, 0.65) !important;
            box-shadow: 0 8px 24px -6px rgba(56, 189, 248, 0.14), inset 0 1px 0 0 rgba(255, 255, 255, 0.85);
        }
        .dark .glass-aurora-card {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(56, 189, 248, 0.18) 50%, rgba(168, 85, 247, 0.22) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(56, 189, 248, 0.35) !important;
            box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
        }
        .glass-aurora-sky {
            background: linear-gradient(135deg, rgba(224, 242, 254, 0.85) 0%, rgba(186, 230, 253, 0.68) 55%, rgba(224, 231, 255, 0.82) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(56, 189, 248, 0.6) !important;
            box-shadow: 0 8px 24px -6px rgba(14, 165, 233, 0.15), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        }
        .dark .glass-aurora-sky {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.22) 0%, rgba(99, 102, 241, 0.2) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(56, 189, 248, 0.4) !important;
        }
        .glass-aurora-purple {
            background: linear-gradient(135deg, rgba(243, 232, 255, 0.85) 0%, rgba(233, 213, 255, 0.72) 50%, rgba(252, 231, 243, 0.8) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(192, 132, 252, 0.65) !important;
            box-shadow: 0 8px 24px -6px rgba(168, 85, 247, 0.15), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        }
        .dark .glass-aurora-purple {
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.24) 0%, rgba(236, 72, 153, 0.18) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(192, 132, 252, 0.42) !important;
        }
        .glass-aurora-emerald {
            background: linear-gradient(135deg, rgba(209, 250, 229, 0.88) 0%, rgba(167, 243, 208, 0.72) 50%, rgba(204, 251, 241, 0.84) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(52, 211, 153, 0.7) !important;
            box-shadow: 0 8px 24px -6px rgba(16, 185, 129, 0.16), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        }
        .dark .glass-aurora-emerald {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(20, 184, 166, 0.2) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(52, 211, 153, 0.45) !important;
        }
        .glass-aurora-amber {
            background: linear-gradient(135deg, rgba(254, 243, 199, 0.88) 0%, rgba(253, 230, 138, 0.72) 50%, rgba(255, 237, 213, 0.85) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(251, 191, 36, 0.75) !important;
            box-shadow: 0 8px 24px -6px rgba(245, 158, 11, 0.16), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        }
        .dark .glass-aurora-amber {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.25) 0%, rgba(234, 88, 12, 0.2) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(251, 191, 36, 0.45) !important;
        }
        .glass-aurora-rose {
            background: linear-gradient(135deg, rgba(255, 228, 230, 0.88) 0%, rgba(254, 205, 211, 0.72) 50%, rgba(250, 232, 255, 0.84) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(251, 113, 133, 0.72) !important;
            box-shadow: 0 8px 24px -6px rgba(244, 63, 94, 0.16), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        }
        .dark .glass-aurora-rose {
            background: linear-gradient(135deg, rgba(244, 63, 94, 0.25) 0%, rgba(168, 85, 247, 0.2) 100%);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1.5px solid rgba(251, 113, 133, 0.45) !important;
        }

        /* Custom scrollbar untuk tampilan POS yang rapi */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.35); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(156, 163, 175, 0.65); }

        @media print {
            body * { visibility: hidden; }
            #receipt-print-area, #receipt-print-area * { visibility: visible; }
            #receipt-print-area {
                position: fixed;
                left: 0;
                top: 0;
                width: 80mm;
                padding: 10px;
                background: white !important;
                color: black !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="bg-clean-light text-zinc-900 dark:text-zinc-100 min-h-screen font-sans antialiased transition-colors duration-200">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[60] flex flex-col gap-2 pointer-events-none max-w-sm"></div>

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 bg-white/85 dark:bg-zinc-950/85 backdrop-blur-xl border-b border-zinc-200/80 dark:border-zinc-800/80">
        <div class="max-w-[1600px] mx-auto px-3 sm:px-6 py-2.5 md:py-0 md:h-16 flex flex-wrap md:flex-nowrap items-center justify-between gap-2.5">
            
            <!-- Brand Logo: PONPRO POS -->
            <div class="flex items-center gap-2.5 sm:gap-3 shrink-0 order-1">
                <div id="brand-app-logo-box" class="relative w-9 h-9 rounded-xl bg-mono-gradient text-white dark:text-zinc-950 flex items-center justify-center shadow-md shadow-zinc-950/15 overflow-hidden">
                    <span class="absolute inset-0 bg-aurora-accent opacity-70 pointer-events-none"></span>
                    <i data-lucide="shopping-bag" class="w-4 h-4 relative z-10"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-sm sm:text-base tracking-tight leading-none flex items-center gap-1.5">
                        <span class="bg-gradient-to-r from-zinc-950 via-zinc-700 to-zinc-500 dark:from-white dark:via-zinc-200 dark:to-zinc-400 bg-clip-text text-transparent">PONPRO</span>
                        <span class="px-1.5 py-0.5 rounded-md text-[10px] font-mono font-bold aurora-pill border border-zinc-200/80 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200">POS</span>
                    </h1>
                    <p class="text-[10px] text-zinc-400 font-medium mt-0.5 hidden sm:block">Minimalist Retail & Stock System</p>
                </div>
            </div>

            <!-- Right Controls: Active Currency Badge, Settings Modal, Theme -->
            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 order-2 md:order-3">
                <button onclick="openSettingsModal()" title="Buka Pengaturan Mata Uang" class="px-2.5 sm:px-3 py-2 rounded-xl aurora-pill border border-zinc-200/90 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 text-xs font-bold flex items-center gap-1.5 hover:opacity-90 transition-all shadow-2xs">
                    <i data-lucide="coins" class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-300"></i>
                    <span class="hidden lg:inline text-zinc-500 dark:text-zinc-400 font-medium">Currency:</span>
                    <span id="active-curr-header" class="font-mono">IDR (Rp)</span>
                </button>

                <button onclick="openSettingsModal()" title="Pengaturan Aplikasi" class="p-2 sm:p-2.5 rounded-xl bg-white/90 hover:bg-zinc-100 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-800 text-zinc-700 dark:text-zinc-200 transition-colors flex items-center gap-1.5 text-xs font-semibold">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span class="hidden lg:inline">Pengaturan</span>
                </button>

                <button onclick="toggleDarkMode()" title="Ganti Tema Terang/Gelap" class="p-2 sm:p-2.5 rounded-xl bg-white/90 hover:bg-zinc-100 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-800 text-zinc-700 dark:text-zinc-200 transition-colors">
                    <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
                    <i data-lucide="sun" class="w-4 h-4 hidden dark:block text-zinc-200"></i>
                </button>
            </div>

            <!-- Main Navigation Tabs -->
            <nav class="w-full md:w-auto order-3 md:order-2 grid grid-cols-4 md:flex items-center bg-zinc-100/90 dark:bg-zinc-900/90 p-1 rounded-xl border border-zinc-200/60 dark:border-zinc-800 gap-1">
                <button onclick="switchTab('kasir')" id="tab-btn-kasir" class="tab-btn px-2 sm:px-3.5 py-2 md:py-1.5 rounded-lg text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 sm:gap-1.5 transition-all whitespace-nowrap bg-mono-gradient !text-white dark:!text-zinc-950 shadow-sm">
                    <i data-lucide="calculator" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Kasir</span>
                </button>
                <button onclick="switchTab('cekstok')" id="tab-btn-cekstok" class="tab-btn px-2 sm:px-3.5 py-2 md:py-1.5 rounded-lg text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 sm:gap-1.5 transition-all whitespace-nowrap text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
                    <i data-lucide="search-check" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Cek Stok</span>
                </button>
                <button onclick="switchTab('inventori')" id="tab-btn-inventori" class="tab-btn px-2 sm:px-3.5 py-2 md:py-1.5 rounded-lg text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 sm:gap-1.5 transition-all whitespace-nowrap text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
                    <i data-lucide="clipboard-list" class="w-3.5 h-3.5 shrink-0"></i>
                    <span class="sm:hidden">Opname</span>
                    <span class="hidden sm:inline">Stok & Opname</span>
                </button>
                <button onclick="switchTab('laporan')" id="tab-btn-laporan" class="tab-btn px-2 sm:px-3.5 py-2 md:py-1.5 rounded-lg text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 sm:gap-1.5 transition-all whitespace-nowrap text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
                    <i data-lucide="bar-chart-3" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Laporan</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-[1600px] mx-auto p-4 sm:p-6">

        <!-- =====================================================================
             TAB 1: KASIR / PENJUALAN CEPAT (MODE BARIS / COMPACT LIST)
        ====================================================================== -->
        <section id="view-kasir" class="tab-view grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Left Panel: Search & Compact List Catalog (7 cols) -->
            <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-3">
                <div class="bg-white/85 dark:bg-zinc-900/85 backdrop-blur-md p-3.5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
                    <div class="flex flex-col sm:flex-row gap-2.5">
                        <div class="relative flex-1">
                            <i data-lucide="search" class="w-4 h-4 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                            <input type="text" id="pos-search-input" oninput="renderPosCatalog()" placeholder="Ketik cepat nama artikel (misal: Boxy Tee, Hoodie)..." 
                                class="w-full pl-10 pr-9 py-2.5 rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-200 text-sm font-medium transition-all">
                            <button onclick="clearPosSearch()" id="pos-clear-search" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-600">
                                <i data-lucide="x-circle" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <select id="pos-size-filter" onchange="renderPosCatalog()" class="px-3.5 py-2.5 rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-200">
                            <option value="ALL">Semua Size</option>
                            <option value="S">Size S</option>
                            <option value="M">Size M</option>
                            <option value="L">Size L</option>
                            <option value="XL">Size XL</option>
                            <option value="XXL">Size XXL</option>
                            <option value="All Size">All Size</option>
                        </select>
                    </div>
                    <div class="flex items-center justify-between mt-2.5 pt-2.5 border-t border-zinc-100 dark:border-zinc-800/80 text-xs text-zinc-500">
                        <span id="pos-catalog-count">Menampilkan 0 artikel</span>
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input type="checkbox" id="pos-hide-oos" onchange="renderPosCatalog()" class="rounded text-zinc-900 focus:ring-zinc-800">
                            <span>Sembunyikan stok habis</span>
                        </label>
                    </div>
                </div>

                <div class="bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm overflow-hidden">
                    <div class="hidden sm:flex items-center justify-between gap-2.5 px-3.5 py-2 bg-gradient-to-r from-zinc-50 via-white to-zinc-50 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950 border-b border-zinc-200/80 dark:border-zinc-800 text-[11px] font-bold uppercase tracking-wider text-zinc-400">
                        <div class="flex-1 min-w-0">Nama Artikel & Sisa Stok</div>
                        <div class="shrink-0">Pilih Size (Sisa Stok)</div>
                        <div class="w-24 text-right shrink-0">Harga Jual</div>
                    </div>
                    <div id="pos-catalog-list" class="divide-y divide-zinc-100 dark:divide-zinc-800/80"></div>
                </div>
            </div>

            <!-- Right Panel: Cart & Checkout (5 cols) -->
            <div class="lg:col-span-5 xl:col-span-4 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex flex-col lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] overflow-visible lg:overflow-hidden">
                <div class="h-1 w-full bg-gradient-to-r from-emerald-300/70 via-sky-300/70 to-purple-300/70 dark:from-emerald-500/40 dark:via-sky-500/40 dark:to-purple-500/40 shrink-0"></div>

                <div class="p-3.5 sm:p-4 border-b border-zinc-200/80 dark:border-zinc-800 flex items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2">
                        <i data-lucide="shopping-cart" class="w-4 h-4 text-zinc-900 dark:text-zinc-100"></i>
                        <h2 class="font-bold text-sm tracking-tight">Keranjang</h2>
                        <span id="cart-badge-count" class="px-2 py-0.5 text-xs font-mono font-bold bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 rounded-full">0</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" onclick="openPendingListModal()" class="relative px-2.5 py-1.5 rounded-lg aurora-pill border border-zinc-200 dark:border-zinc-700 text-[11px] font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-1 hover:opacity-90 transition-all">
                            <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-600"></i>
                            <span>Pending</span>
                            <span id="pending-badge-count" class="px-1.5 py-0.2 rounded-full bg-amber-500 text-white text-[10px] font-mono font-extrabold">0</span>
                        </button>
                        <button onclick="clearCart()" class="text-xs font-semibold text-zinc-500 hover:text-rose-600 dark:text-zinc-400 flex items-center gap-1 px-2 py-1.5 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span class="hidden sm:inline">Kosongkan</span>
                        </button>
                    </div>
                </div>

                <div id="cart-items-list" class="lg:flex-1 lg:overflow-y-auto p-3.5 sm:p-4 space-y-2.5 min-h-[120px] max-h-[40vh] lg:max-h-none overflow-y-auto"></div>

                <div class="p-3.5 sm:p-4 border-t border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/60 space-y-3 shrink-0 pb-5 sm:pb-4">
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label class="text-[11px] font-bold uppercase tracking-wider text-zinc-500 flex items-center gap-1.5">
                                <span>Diskon Nominal (<span class="curr-symbol">Rp</span>)</span>
                                <span id="discount-saved-badge" class="hidden px-1.5 py-0.2 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 text-[9px] font-extrabold">TETAP</span>
                            </label>
                            <button type="button" onclick="resetDiscount()" class="text-[11px] font-semibold text-zinc-500 hover:text-rose-600">Reset / 0</button>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="relative flex-1">
                                <span class="curr-symbol text-xs font-mono font-bold text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2">Rp</span>
                                <input type="number" id="cart-discount-value" min="0" step="any" value="0" oninput="handleDiscountChange()"
                                    class="w-full pl-9 pr-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-200">
                            </div>
                            <button type="button" onclick="openSettingsModal()" title="Atur Preset Nama & Nominal Diskon" class="px-2.5 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 text-[11px] font-bold flex items-center gap-1 shrink-0">
                                <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                                <span>Atur Preset</span>
                            </button>
                        </div>
                        <div id="quick-discount-buttons" class="flex flex-wrap gap-1.5 pt-0.5"></div>
