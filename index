            const presets = state.discountPresets[state.currency] || [];
            container.innerHTML = presets.map((p, idx) => `
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 text-xs font-bold">
