        function handleExcelUpload(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const wb = XLSX.read(data, { type: 'array' });
                    const sheet = wb.Sheets[wb.SheetNames[0]];
                    const rows = XLSX.utils.sheet_to_json(sheet, { defval: '' });

                    let updatedCount = 0;
                    let addedCount = 0;

                    rows.forEach(r => {
                        const norm = {};
                        Object.keys(r).forEach(k => norm[k.trim().toLowerCase()] = r[k]);
                        const name = String(norm['nama artikel'] || norm['artikel'] || norm['nama'] || '').trim();
                        if (!name) return;
                        const size = String(norm['size'] || norm['ukuran'] || 'All Size').trim() || 'All Size';
                        const stock = Math.max(0, parseInt(norm['sisa stok'] ?? norm['stok'] ?? 0, 10) || 0);
                        const hpp = Math.max(0, Number(norm['harga hpp'] ?? norm['hpp'] ?? 0) || 0);
                        const price = Math.max(0, Number(norm['harga jual'] ?? norm['harga'] ?? 0) || 0);

                        const existing = state.products.find(p => p.name.toLowerCase() === name.toLowerCase() && p.size.toLowerCase() === size.toLowerCase());
                        if (existing) {
                            existing.stock = stock;
                            if (hpp > 0) existing.hpp = hpp;
                            if (price > 0) existing.price = price;
                            updatedCount++;
                        } else {
                            state.products.push({
                                id: `sku-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
                                name,
                                size,
                                stock,
                                hpp,
                                price
                            });
                            addedCount++;
                        }
                    });

                    saveState();
                    renderAll();
                    showToast(`Import selesai: ${updatedCount} diperbarui, ${addedCount} baru`);
                } catch (err) {
                    console.error(err);
                    showToast('Gagal membaca file Excel. Periksa format kolom!', 'error');
                } finally {
                    event.target.value = '';
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function handleManualAddProduct(event) {
            event.preventDefault();
            const name = document.getElementById('add-name').value.trim();
            const size = document.getElementById('add-size').value.trim() || 'All Size';
            const stock = Math.max(0, parseInt(document.getElementById('add-stock').value, 10) || 0);
            const hpp = Math.max(0, Number(document.getElementById('add-hpp').value) || 0);
            const price = Math.max(0, Number(document.getElementById('add-price').value) || 0);

            if (!name) return;
            const existing = state.products.find(p => p.name.toLowerCase() === name.toLowerCase() && p.size.toLowerCase() === size.toLowerCase());
            if (existing) {
                existing.stock += stock;
                existing.hpp = hpp;
                existing.price = price;
                showToast(`Stok ${name} (${size}) ditambahkan +${stock} pcs`);
            } else {
                state.products.unshift({
                    id: `sku-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
                    name,
                    size,
                    stock,
                    hpp,
                    price
                });
                showToast(`Artikel baru ${name} (${size}) disimpan`);
            }

            event.target.reset();
            document.getElementById('add-stock').value = 10;
            saveState();
            renderAll();
        }

        function resetInventoryPageAndRender() {
            state.invPage = 1;
            renderInventoryTable();
        }

        function changeInventoryRowsPerPage(val) {
            state.invRowsPerPage = parseInt(val, 10) || 10;
            state.invPage = 1;
            renderInventoryTable();
        }

        function changeInventoryPage(delta) {
            state.invPage = Math.max(1, state.invPage + delta);
            renderInventoryTable();
        }

        function getFilteredInventoryProducts() {
            const q = (document.getElementById('inv-search-input')?.value || '').trim().toLowerCase();
            if (!q) return state.products;
            return state.products.filter(p => `${p.name} ${p.size}`.toLowerCase().includes(q));
        }

        function renderInventoryTable() {
            const tbody = document.getElementById('inventory-table-body');
            if (!tbody) return;

            const filtered = getFilteredInventoryProducts();
            const totalRows = filtered.length;
            const perPage = state.invRowsPerPage || 10;
            const totalPages = Math.max(1, Math.ceil(totalRows / perPage));
            if (state.invPage > totalPages) state.invPage = totalPages;

            const startIdx = (state.invPage - 1) * perPage;
            const pageRows = filtered.slice(startIdx, startIdx + perPage);

            const infoEl = document.getElementById('inv-pagination-info');
            const indEl = document.getElementById('inv-page-indicator');
            const prevBtn = document.getElementById('inv-prev-page');
            const nextBtn = document.getElementById('inv-next-page');
            if (infoEl) infoEl.textContent = `Menampilkan ${pageRows.length} dari ${totalRows} SKU`;
            if (indEl) indEl.textContent = `Hal ${state.invPage} / ${totalPages}`;
            if (prevBtn) prevBtn.disabled = state.invPage <= 1;
            if (nextBtn) nextBtn.disabled = state.invPage >= totalPages;

            const selectAllCb = document.getElementById('inv-select-all');
            if (selectAllCb) {
                selectAllCb.checked = pageRows.length > 0 && pageRows.every(r => state.selectedInventoryIds.includes(r.id));
            }
            updateInventoryBulkBar();

            if (pageRows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-10 text-center text-zinc-400">Tidak ada SKU barang yang ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = pageRows.map(p => {
                const isChecked = state.selectedInventoryIds.includes(p.id);
                return `
                    <tr class="hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 ${isChecked ? 'bg-sky-50/50 dark:bg-sky-950/20' : ''}">
                        <td class="py-2.5 px-3 text-center">
                            <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="toggleInventoryRowSelection('${p.id}', this.checked)" class="rounded text-zinc-900 focus:ring-zinc-800 cursor-pointer">
                        </td>
                        <td class="py-2.5 px-3 font-bold text-zinc-900 dark:text-white">${escapeHtml(p.name)}</td>
                        <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono font-bold text-[11px]">${escapeHtml(p.size)}</span></td>
                        <td class="py-2.5 px-3 text-right font-mono text-zinc-500">${formatCurrency(p.hpp)}</td>
                        <td class="py-2.5 px-3 text-right font-mono font-bold">${formatCurrency(p.price)}</td>
                        <td class="py-2.5 px-3 text-center font-mono font-extrabold">${p.stock}</td>
                        <td class="py-2.5 px-3 text-center">
                            <input type="number" min="0" data-sku-id="${p.id}" data-sys-stock="${p.stock}" oninput="updateOpnameDiff(this)" placeholder="${p.stock}"
                                class="opname-physical-input w-20 px-2 py-1 rounded-lg bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-700 text-center font-mono font-bold text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </td>
                        <td class="py-2.5 px-3 text-center font-mono font-bold" id="opname-diff-${p.id}">-</td>
                        <td class="py-2.5 px-4 text-right">
                            <div class="inline-flex items-center gap-1.5">
                                <button type="button" onclick="openPurchaseStockModal(['${p.id}'])" class="px-2.5 py-1 rounded-lg aurora-pill border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[11px] font-bold hover:opacity-90">Sesuaikan</button>
                                <button type="button" onclick="deleteProductSku('${p.id}')" title="Hapus SKU" class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
            updateCommitOpnameButtonState();
            lucide.createIcons();
        }

        function toggleSelectAllInventory(checked) {
            const filtered = getFilteredInventoryProducts();
            const perPage = state.invRowsPerPage || 10;
            const startIdx = (state.invPage - 1) * perPage;
            const pageRows = filtered.slice(startIdx, startIdx + perPage);

            pageRows.forEach(r => {
                const idx = state.selectedInventoryIds.indexOf(r.id);
                if (checked && idx === -1) state.selectedInventoryIds.push(r.id);
                if (!checked && idx !== -1) state.selectedInventoryIds.splice(idx, 1);
            });
            renderInventoryTable();
        }

        function toggleInventoryRowSelection(skuId, checked) {
            const idx = state.selectedInventoryIds.indexOf(skuId);
            if (checked && idx === -1) state.selectedInventoryIds.push(skuId);
            if (!checked && idx !== -1) state.selectedInventoryIds.splice(idx, 1);
            renderInventoryTable();
        }

        function updateInventoryBulkBar() {
            const bar = document.getElementById('inv-bulk-action-bar');
            const cnt = document.getElementById('inv-selected-count');
            if (!bar || !cnt) return;
            const validSelected = state.selectedInventoryIds.filter(id => state.products.some(p => p.id === id));
            state.selectedInventoryIds = validSelected;
            cnt.textContent = validSelected.length;
            bar.classList.toggle('hidden', validSelected.length === 0);
        }

        function clearInventorySelection() {
            state.selectedInventoryIds = [];
            renderInventoryTable();
        }

        function openBulkPurchaseFromSelection() {
            if (state.selectedInventoryIds.length === 0) return;
            openPurchaseStockModal([...state.selectedInventoryIds]);
        }

        function deleteSelectedSkus() {
            const count = state.selectedInventoryIds.length;
            if (count === 0) return;
            openConfirmModal(
                `Hapus ${count} SKU Terpilih?`,
                'SKU yang dihapus akan hilang dari daftar inventori dan kasir.',
                () => {
                    state.products = state.products.filter(p => !state.selectedInventoryIds.includes(p.id));
                    state.selectedInventoryIds = [];
                    saveState();
                    renderAll();
                    showToast(`${count} SKU berhasil dihapus`);
                }
            );
        }

        function deleteProductSku(skuId) {
            const prod = state.products.find(p => p.id === skuId);
            if (!prod) return;
            openConfirmModal(
                `Hapus ${prod.name} (${prod.size})?`,
                'Varian barang ini akan dihapus dari database stok.',
                () => {
                    state.products = state.products.filter(p => p.id !== skuId);
                    state.selectedInventoryIds = state.selectedInventoryIds.filter(id => id !== skuId);
                    saveState();
                    renderAll();
                    showToast(`${prod.name} (${prod.size}) dihapus`);
                }
            );
        }

        // Stok Opname Fisik Langsung di Tabel
        function updateOpnameDiff(inputEl) {
            const skuId = inputEl.getAttribute('data-sku-id');
            const sysStock = Number(inputEl.getAttribute('data-sys-stock')) || 0;
            const diffCell = document.getElementById(`opname-diff-${skuId}`);
            if (!diffCell) return;

            if (inputEl.value === '') {
                diffCell.textContent = '-';
                diffCell.className = 'py-2.5 px-3 text-center font-mono font-bold text-zinc-400';
            } else {
                const phys = Math.max(0, parseInt(inputEl.value, 10) || 0);
                const diff = phys - sysStock;
                diffCell.textContent = diff > 0 ? `+${diff}` : `${diff}`;
                diffCell.className = diff > 0
                    ? 'py-2.5 px-3 text-center font-mono font-bold text-emerald-600 dark:text-emerald-400'
                    : diff < 0
                        ? 'py-2.5 px-3 text-center font-mono font-bold text-rose-600 dark:text-rose-400'
                        : 'py-2.5 px-3 text-center font-mono font-bold text-zinc-500';
            }
            updateCommitOpnameButtonState();
        }

        function updateCommitOpnameButtonState() {
            const inputs = Array.from(document.querySelectorAll('.opname-physical-input')).filter(i => i.value !== '');
            const lbl = document.getElementById('btn-commit-opname-label');
            if (lbl) {
                lbl.textContent = inputs.length > 0 ? `Simpan Opname (${inputs.length})` : 'Simpan Opname';
            }
        }

        function commitStokOpname() {
            const inputs = Array.from(document.querySelectorAll('.opname-physical-input')).filter(i => i.value !== '');
            if (inputs.length === 0) {
                showToast('Isi minimal satu kolom Stok Fisik (Opname) pada tabel terlebih dahulu', 'warning');
                return;
            }

            const logItems = [];
            inputs.forEach(inp => {
                const skuId = inp.getAttribute('data-sku-id');
                const prod = state.products.find(p => p.id === skuId);
                if (!prod) return;
                const oldStock = Number(prod.stock) || 0;
                const newStock = Math.max(0, parseInt(inp.value, 10) || 0);
                const diff = newStock - oldStock;
                prod.stock = newStock;
                logItems.push({
                    name: prod.name,
                    size: prod.size,
                    oldStock,
                    newStock,
                    diff
                });
            });

            if (logItems.length > 0) {
                state.opnameLogs.unshift({
                    id: `OPN-${Date.now().toString().slice(-6)}`,
                    timestamp: new Date().toISOString(),
                    type: 'Stok Opname Fisik',
                    note: 'Penyesuaian hitung fisik rak',
                    items: logItems
                });
                saveState();
                renderAll();
                showToast(`Stok opname ${logItems.length} SKU berhasil disimpan!`);
            }
        }

        // Modal Penyesuaian Stok Multi-Barang (+ Pembelian / - Pengurangan)
        function openPurchaseStockModal(preselectSkuIds = []) {
            state.purchaseDraftItems = [];
            document.getElementById('purchase-sku-search').value = '';
            document.getElementById('purchase-note-input').value = '';
            filterPurchaseSkuOptions();

            if (Array.isArray(preselectSkuIds) && preselectSkuIds.length > 0) {
                preselectSkuIds.forEach(id => {
                    const prod = state.products.find(p => p.id === id);
                    if (prod && !state.purchaseDraftItems.some(d => d.id === prod.id)) {
                        state.purchaseDraftItems.push({
                            id: prod.id,
                            name: prod.name,
                            size: prod.size,
                            currentStock: Number(prod.stock) || 0,
                            delta: 1,
                            hpp: Number(prod.hpp) || 0
                        });
                    }
                });
            }

            renderPurchaseDraftItems();
            document.getElementById('purchase-stock-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closePurchaseStockModal() {
            document.getElementById('purchase-stock-modal').classList.add('hidden');
        }

        function filterPurchaseSkuOptions() {
            const selectEl = document.getElementById('purchase-sku-select');
            if (!selectEl) return;
            const q = (document.getElementById('purchase-sku-search')?.value || '').trim().toLowerCase();
            const matches = state.products.filter(p => !q || `${p.name} ${p.size}`.toLowerCase().includes(q));
            if (matches.length === 0) {
                selectEl.innerHTML = `<option value="">Tidak ditemukan</option>`;
                return;
            }
            selectEl.innerHTML = matches.map(p => `<option value="${p.id}">${escapeHtml(p.name)} (${escapeHtml(p.size)}) • Stok: ${p.stock}</option>`).join('');
        }

        function addSelectedSkuToPurchaseList() {
            const skuId = document.getElementById('purchase-sku-select')?.value;
            if (!skuId) return;
            const prod = state.products.find(p => p.id === skuId);
            if (!prod) return;
            if (state.purchaseDraftItems.some(d => d.id === prod.id)) {
                showToast('SKU tersebut sudah ada di daftar', 'warning');
                return;
            }
            state.purchaseDraftItems.push({
                id: prod.id,
                name: prod.name,
                size: prod.size,
                currentStock: Number(prod.stock) || 0,
                delta: 1,
                hpp: Number(prod.hpp) || 0
            });
            renderPurchaseDraftItems();
        }

        function updatePurchaseDraftDelta(idx, val) {
            if (!state.purchaseDraftItems[idx]) return;
            state.purchaseDraftItems[idx].delta = parseInt(val, 10) || 0;
            renderPurchaseDraftItems();
        }

        function updatePurchaseDraftHpp(idx, val) {
            if (!state.purchaseDraftItems[idx]) return;
            state.purchaseDraftItems[idx].hpp = Math.max(0, Number(val) || 0);
        }

        function removePurchaseDraftItem(idx) {
            state.purchaseDraftItems.splice(idx, 1);
            renderPurchaseDraftItems();
        }

        function clearPurchaseItemsList() {
            state.purchaseDraftItems = [];
            renderPurchaseDraftItems();
        }

        function renderPurchaseDraftItems() {
            const container = document.getElementById('purchase-items-container');
            const countEl = document.getElementById('purchase-items-count');
            const summaryEl = document.getElementById('purchase-total-summary');
            if (!container) return;

            if (countEl) countEl.textContent = state.purchaseDraftItems.length;

            let totalIn = 0;
            let totalOut = 0;
            state.purchaseDraftItems.forEach(it => {
                if (it.delta > 0) totalIn += it.delta;
                if (it.delta < 0) totalOut += Math.abs(it.delta);
            });
            if (summaryEl) summaryEl.textContent = `Masuk: +${totalIn} | Keluar: -${totalOut}`;

            if (state.purchaseDraftItems.length === 0) {
                container.innerHTML = `<div class="p-6 text-center rounded-xl border border-dashed border-zinc-200 dark:border-zinc-800 text-xs text-zinc-400">Belum ada barang dipilih. Cari artikel di atas lalu klik <strong>Tambah</strong>.</div>`;
                return;
            }

            container.innerHTML = state.purchaseDraftItems.map((it, idx) => {
                const after = Math.max(0, it.currentStock + it.delta);
                return `
                    <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200/80 dark:border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                        <div class="min-w-0 flex-1">
                            <p class="font-bold text-xs text-zinc-900 dark:text-white truncate">${escapeHtml(it.name)} <span class="font-mono text-zinc-500">(${escapeHtml(it.size)})</span></p>
                            <p class="text-[11px] font-mono text-zinc-500 mt-0.5">Stok: ${it.currentStock} → <strong class="${it.delta > 0 ? 'text-emerald-600' : it.delta < 0 ? 'text-rose-600' : ''}">${after}</strong></p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <div>
                                <label class="block text-[9px] font-bold uppercase text-zinc-400">Jumlah (+/-)</label>
                                <input type="number" value="${it.delta}" onchange="updatePurchaseDraftDelta(${idx}, this.value)"
                                    class="w-20 px-2 py-1 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-center font-mono font-bold text-xs">
                            </div>
                            ${it.delta > 0 ? `
                            <div>
                                <label class="block text-[9px] font-bold uppercase text-zinc-400">HPP Satuan</label>
                                <input type="number" min="0" step="any" value="${it.hpp}" oninput="updatePurchaseDraftHpp(${idx}, this.value)"
                                    class="w-24 px-2 py-1 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-right font-mono font-bold text-xs">
                            </div>` : ''}
                            <button type="button" onclick="removePurchaseDraftItem(${idx})" class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-600 mt-3">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
            lucide.createIcons();
        }

        function submitPurchaseStock(event) {
            event.preventDefault();
            const validItems = state.purchaseDraftItems.filter(it => Number(it.delta) !== 0);
            if (validItems.length === 0) {
                showToast('Masukkan jumlah penyesuaian (+/-) minimal pada 1 barang', 'warning');
                return;
            }

            const note = (document.getElementById('purchase-note-input')?.value || '').trim();
            const logItems = [];

            validItems.forEach(it => {
                const prod = state.products.find(p => p.id === it.id);
                if (!prod) return;
                const oldStock = Number(prod.stock) || 0;
                const newStock = Math.max(0, oldStock + Number(it.delta));
                prod.stock = newStock;
                if (it.delta > 0 && it.hpp >= 0) {
                    prod.hpp = Number(it.hpp);
                }
                logItems.push({
                    name: prod.name,
                    size: prod.size,
                    oldStock,
                    newStock,
                    diff: newStock - oldStock
                });
            });

            state.opnameLogs.unshift({
                id: `ADJ-${Date.now().toString().slice(-6)}`,
                timestamp: new Date().toISOString(),
                type: 'Penyesuaian Stok',
                note: note || 'Penyesuaian stok manual',
                items: logItems
            });

            saveState();
            closePurchaseStockModal();
            renderAll();
            showToast(`Penyesuaian stok ${logItems.length} SKU berhasil disimpan!`);
        }

        // Riwayat Penyesuaian & Opname (Dropdown Accordion + Modal)
        function openOpnameHistoryModal() {
            renderOpnameHistory();
            document.getElementById('opname-history-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeOpnameHistoryModal() {
            document.getElementById('opname-history-modal').classList.add('hidden');
        }

        function buildOpnameHistoryHtml(logs) {
            if (!logs || logs.length === 0) {
                return `<div class="p-6 text-center rounded-xl bg-zinc-50 dark:bg-zinc-950/60 border border-dashed border-zinc-200 dark:border-zinc-800 text-zinc-400">Belum ada riwayat penyesuaian atau stok opname.</div>`;
            }
            return logs.map(log => {
                const items = Array.isArray(log.items) ? log.items : [];
                return `
                    <details class="group rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200/80 dark:border-zinc-800 overflow-hidden">
                        <summary class="px-3.5 py-2.5 cursor-pointer select-none flex items-center justify-between gap-2 hover:bg-zinc-100/70 dark:hover:bg-zinc-800/40 list-none">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="font-mono text-[11px] text-zinc-400">${new Date(log.timestamp).toLocaleString('id-ID')}</span>
                                    <span class="px-2 py-0.2 rounded aurora-pill border border-zinc-200 dark:border-zinc-700 font-bold text-[10px] text-zinc-800 dark:text-zinc-200">${escapeHtml(log.type || 'Penyesuaian')}</span>
                                    <span class="px-1.5 py-0.2 rounded bg-zinc-200/80 dark:bg-zinc-800 font-mono text-[10px] font-bold">${items.length} SKU</span>
                                </div>
                                ${log.note ? `<p class="text-[11px] font-semibold text-zinc-700 dark:text-zinc-300 mt-0.5 truncate">${escapeHtml(log.note)}</p>` : ''}
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-zinc-400 transition-transform group-open:rotate-180 shrink-0"></i>
                        </summary>
                        <div class="px-3.5 py-2.5 border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 divide-y divide-zinc-100 dark:divide-zinc-800">
                            ${items.map(it => {
                                const diffBadge = it.diff > 0
                                    ? `<span class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 font-mono font-bold text-[11px]">+${it.diff}</span>`
                                    : it.diff < 0
                                        ? `<span class="px-2 py-0.5 rounded bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 font-mono font-bold text-[11px]">${it.diff}</span>`
                                        : `<span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 font-mono font-bold text-[11px]">0</span>`;
                                return `
                                    <div class="py-1.5 flex items-center justify-between gap-2 text-xs">
                                        <span class="font-bold text-zinc-800 dark:text-zinc-200 truncate">${escapeHtml(it.name)} <span class="font-mono text-zinc-400">(${escapeHtml(it.size)})</span></span>
                                        <div class="flex items-center gap-2 shrink-0">
                                            <span class="font-mono text-zinc-500">${it.oldStock} → <strong class="text-zinc-900 dark:text-white">${it.newStock}</strong></span>
                                            ${diffBadge}
                                        </div>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    </details>
                `;
            }).join('');
        }

        function renderOpnameHistory() {
            const badge = document.getElementById('opname-log-count-badge');
            if (badge) badge.textContent = state.opnameLogs.length;

            const inlineList = document.getElementById('opname-history-list');
            if (inlineList) inlineList.innerHTML = buildOpnameHistoryHtml(state.opnameLogs.slice(0, 3));

            const modalList = document.getElementById('opname-history-modal-list');
            if (modalList) modalList.innerHTML = buildOpnameHistoryHtml(state.opnameLogs);

            lucide.createIcons();
        }

        // =====================================================================
        // 9. SALES REPORTS, DATE FILTER, VOID & EXPORT EXCEL
        // =====================================================================
        function setReportDateFilter(dateStr) {
            state.reportDateFilter = dateStr || 'ALL';
            const resetBtn = document.getElementById('btn-reset-report-date');
            if (resetBtn) resetBtn.classList.toggle('hidden', state.reportDateFilter === 'ALL');
            renderReports();
        }

        function resetReportDateFilter() {
            state.reportDateFilter = 'ALL';
            const picker = document.getElementById('report-date-picker');
            if (picker) picker.value = '';
            const resetBtn = document.getElementById('btn-reset-report-date');
            if (resetBtn) resetBtn.classList.add('hidden');
            renderReports();
        }

        function getFilteredTransactions() {
            if (!state.reportDateFilter || state.reportDateFilter === 'ALL') {
                return state.transactions;
            }
            return state.transactions.filter(tx => {
                const d = new Date(tx.timestamp);
                const localYmd = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                return localYmd === state.reportDateFilter;
            });
        }

        function renderReports() {
            const filtered = getFilteredTransactions();

            let totalQty = 0;
            let netRevenue = 0;
            let totalDiscount = 0;
            let totalHpp = 0;
            let netProfit = 0;

            const payTotals = { Cash: 0, QRIS: 0, PayNow: 0 };
            const payCounts = { Cash: 0, QRIS: 0, PayNow: 0 };
            const bestSellerMap = new Map();

            filtered.forEach(tx => {
                const txTotal = Number(tx.total) || 0;
                const txDisc = Number(tx.discount) || 0;
                const txHpp = Number(tx.totalHpp) || 0;
                const txProfit = Number(tx.profit) || 0;

                netRevenue += txTotal;
                totalDiscount += txDisc;
                totalHpp += txHpp;
                netProfit += txProfit;

                const pm = tx.paymentMethod || 'Cash';
                if (payTotals[pm] !== undefined) {
                    payTotals[pm] += txTotal;
                    payCounts[pm] += 1;
                }

                (tx.items || []).forEach(it => {
                    const q = Number(it.qty) || 0;
                    totalQty += q;
                    const key = `${it.name} (${it.size})`;
                    bestSellerMap.set(key, (bestSellerMap.get(key) || 0) + q);
                });
            });

            const margin = netRevenue > 0 ? ((netProfit / netRevenue) * 100).toFixed(1) : '0.0';

            const qtyEl = document.getElementById('rep-total-qty');
            const txEl = document.getElementById('rep-total-tx');
            const revEl = document.getElementById('rep-net-revenue');
            const discEl = document.getElementById('rep-total-discount');
            const hppEl = document.getElementById('rep-total-hpp');
            const profEl = document.getElementById('rep-net-profit');
            const margEl = document.getElementById('rep-profit-margin');
            const badgeEl = document.getElementById('rep-table-badge');

            if (qtyEl) qtyEl.textContent = `${totalQty} pcs`;
            if (txEl) txEl.textContent = `${filtered.length} transaksi`;
            if (revEl) revEl.textContent = formatCurrency(netRevenue);
            if (discEl) discEl.textContent = `Diskon: ${formatCurrency(totalDiscount)}`;
            if (hppEl) hppEl.textContent = formatCurrency(totalHpp);
            if (profEl) profEl.textContent = formatCurrency(netProfit);
            if (margEl) margEl.textContent = `Margin: ${margin}%`;
            if (badgeEl) badgeEl.textContent = `${filtered.length} transaksi`;

            const payBox = document.getElementById('rep-payment-breakdown');
            if (payBox) {
                payBox.innerHTML = ['Cash', 'QRIS', 'PayNow'].map(method => {
                    const amt = payTotals[method] || 0;
                    const cnt = payCounts[method] || 0;
                    const pct = netRevenue > 0 ? Math.round((amt / netRevenue) * 100) : 0;
                    return `
                        <div class="p-3 rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200/80 dark:border-zinc-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-zinc-800 dark:text-zinc-200">${method} <span class="text-zinc-400 font-normal">(${cnt}x)</span></span>
                                <span class="font-mono font-extrabold text-zinc-950 dark:text-white">${formatCurrency(amt)}</span>
                            </div>
                            <div class="w-full h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden">
                                <div class="h-full bg-mono-gradient rounded-full" style="width: ${pct}%"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            const bestBox = document.getElementById('rep-bestsellers-list');
            if (bestBox) {
                const topItems = Array.from(bestSellerMap.entries()).sort((a, b) => b[1] - a[1]).slice(0, 5);
                if (topItems.length === 0) {
                    bestBox.innerHTML = `<div class="py-8 text-center text-zinc-400">Belum ada data penjualan pada periode ini.</div>`;
                } else {
                    bestBox.innerHTML = topItems.map(([label, q], idx) => `
                        <div class="p-2.5 rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200/80 dark:border-zinc-800 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="w-6 h-6 rounded-lg aurora-pill border border-zinc-200 dark:border-zinc-700 font-mono font-extrabold text-[11px] flex items-center justify-center shrink-0">#${idx + 1}</span>
                                <span class="font-bold text-zinc-800 dark:text-zinc-200 truncate">${escapeHtml(label)}</span>
                            </div>
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 font-mono font-extrabold text-[11px] shrink-0">${q} pcs</span>
                        </div>
                    `).join('');
                }
            }

            const tbody = document.getElementById('rep-transactions-body');
            if (tbody) {
                if (filtered.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-zinc-400">Belum ada riwayat transaksi penjualan.</td></tr>`;
                } else {
                    tbody.innerHTML = filtered.map(tx => {
                        const itemsSummary = (tx.items || []).map(i => `${escapeHtml(i.name)} (${escapeHtml(i.size)}) ×${i.qty}`).join(', ');
                        const discBadge = tx.discount > 0
                            ? `<span class="inline-block mt-1 px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 text-[10px] font-bold">Diskon${tx.discountName ? ` (${escapeHtml(tx.discountName)})` : ''}: -${formatCurrency(tx.discount)}</span>`
                            : '';
                        return `
                            <tr class="hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40">
                                <td class="py-3 px-4 align-top">
                                    <p class="font-mono font-extrabold text-zinc-900 dark:text-white">${escapeHtml(tx.id)}</p>
                                    <p class="text-[11px] text-zinc-400 mt-0.5">${new Date(tx.timestamp).toLocaleString('id-ID')}</p>
                                </td>
                                <td class="py-3 px-4 align-top max-w-xs">
                                    <p class="font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed">${itemsSummary}</p>
                                    ${discBadge}
                                </td>
                                <td class="py-3 px-4 align-top">
                                    <span class="px-2 py-0.5 rounded-md aurora-pill border border-zinc-200 dark:border-zinc-700 font-bold text-[11px]">${escapeHtml(tx.paymentMethod)}</span>
                                </td>
                                <td class="py-3 px-4 align-top text-right font-mono font-extrabold text-zinc-950 dark:text-white">${formatCurrency(tx.total)}</td>
                                <td class="py-3 px-4 align-top text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">${formatCurrency(tx.profit)}</td>
                                <td class="py-3 px-4 align-top text-right">
                                    <div class="inline-flex items-center gap-1.5">
                                        <button type="button" onclick="openReceiptByTxId('${tx.id}')" class="px-2.5 py-1 rounded-lg aurora-pill border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[11px] font-bold hover:opacity-90 flex items-center gap-1">
                                            <i data-lucide="receipt" class="w-3 h-3"></i>
                                            <span>Resi</span>
                                        </button>
                                        <button type="button" onclick="voidTransaction('${tx.id}')" class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 text-[11px] font-bold">
                                            Void
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            }
            lucide.createIcons();
        }

        function voidTransaction(txId) {
            const idx = state.transactions.findIndex(t => t.id === txId);
            if (idx === -1) return;
            const tx = state.transactions[idx];

            openConfirmModal(
                `Batalkan (Void) Transaksi ${tx.id}?`,
                'Transaksi akan dihapus dari laporan dan stok barang yang terjual akan dikembalikan otomatis ke sistem.',
                () => {
                    (tx.items || []).forEach(it => {
                        const prod = state.products.find(p => p.id === it.id);
                        if (prod) prod.stock = (Number(prod.stock) || 0) + (Number(it.qty) || 0);
                    });
                    state.transactions.splice(idx, 1);
                    saveState();
                    renderAll();
                    showToast(`Transaksi ${tx.id} dibatalkan & stok dikembalikan`);
                }
            );
        }

        function exportSalesReportExcel() {
            const filtered = getFilteredTransactions();
            if (filtered.length === 0) {
                showToast('Tidak ada data transaksi untuk diexport', 'warning');
                return;
            }
            const rows = filtered.map(tx => ({
                'ID Transaksi': tx.id,
                'Waktu': new Date(tx.timestamp).toLocaleString('id-ID'),
                'Item Terjual': (tx.items || []).map(i => `${i.name} (${i.size}) x${i.qty}`).join('; '),
                'Subtotal': tx.subtotal,
                'Nama Diskon': tx.discountName || '-',
                'Nominal Diskon': tx.discount || 0,
                'Total Bayar': tx.total,
                'Total HPP': tx.totalHpp,
                'Profit Bersih': tx.profit,
                'Metode Pembayaran': tx.paymentMethod
            }));
            const ws = XLSX.utils.json_to_sheet(rows);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Laporan_Penjualan');
            const suffix = state.reportDateFilter !== 'ALL' ? state.reportDateFilter : new Date().toISOString().slice(0, 10);
            XLSX.writeFile(wb, `Laporan_PONPRO_POS_${suffix}.xlsx`);
            showToast('Laporan penjualan berhasil diexport ke Excel');
        }

