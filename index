        function generateReportPngPreview() {
            const canvas = document.getElementById('share-report-canvas');
            const previewImg = document.getElementById('share-report-preview-img');
            if (!canvas || !previewImg) return;

            const isDark = state.reportPngTheme === 'dark';
            const filtered = getFilteredTransactions();

            let totalQty = 0, netRevenue = 0, totalHpp = 0, netProfit = 0;
            const payMap = { Cash: 0, QRIS: 0, PayNow: 0 };
            const articleMap = new Map();

            filtered.forEach(tx => {
                netRevenue += Number(tx.total) || 0;
                totalHpp += Number(tx.totalHpp) || 0;
                netProfit += Number(tx.profit) || 0;
                if (payMap[tx.paymentMethod] !== undefined) payMap[tx.paymentMethod] += Number(tx.total) || 0;
                tx.items.forEach(i => {
                    const q = Number(i.qty) || 0;
                    totalQty += q;
                    const key = `${i.name} (${i.size})`;
                    articleMap.set(key, (articleMap.get(key) || 0) + q);
                });
            });

            const top3 = Array.from(articleMap.entries()).sort((a, b) => b[1] - a[1]).slice(0, 3);
            const margin = netRevenue > 0 ? ((netProfit / netRevenue) * 100).toFixed(1) : '0.0';
            const prof = state.storeProfile || DEFAULT_STORE_PROFILE;

            const W = 760;
            const H = 1040;
            canvas.width = W;
            canvas.height = H;
            const ctx = canvas.getContext('2d');

            // Background Gradient
            const bgGrad = ctx.createLinearGradient(0, 0, W, H);
            if (isDark) {
                bgGrad.addColorStop(0, '#09090b');
                bgGrad.addColorStop(0.5, '#0f172a');
                bgGrad.addColorStop(1, '#020617');
            } else {
                bgGrad.addColorStop(0, '#ffffff');
                bgGrad.addColorStop(0.5, '#f8fafc');
                bgGrad.addColorStop(1, '#f1f5f9');
            }
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, W, H);

            // Aurora Glow Orbs
            const orb1 = ctx.createRadialGradient(120, 120, 10, 120, 120, 320);
            orb1.addColorStop(0, isDark ? 'rgba(56, 189, 248, 0.22)' : 'rgba(56, 189, 248, 0.16)');
            orb1.addColorStop(1, 'transparent');
            ctx.fillStyle = orb1;
            ctx.fillRect(0, 0, W, H);

            const orb2 = ctx.createRadialGradient(W - 100, H - 140, 10, W - 100, H - 140, 340);
            orb2.addColorStop(0, isDark ? 'rgba(16, 185, 129, 0.20)' : 'rgba(16, 185, 129, 0.14)');
            orb2.addColorStop(1, 'transparent');
            ctx.fillStyle = orb2;
            ctx.fillRect(0, 0, W, H);

            const textMain = isDark ? '#ffffff' : '#09090b';
            const textSub = isDark ? '#a1a1aa' : '#52525b';
            const cardBg = isDark ? 'rgba(24, 24, 27, 0.82)' : 'rgba(255, 255, 255, 0.88)';
            const cardBorder = isDark ? 'rgba(63, 63, 70, 0.8)' : 'rgba(228, 228, 231, 0.95)';

            // Header
            ctx.fillStyle = textMain;
            ctx.font = '800 32px Inter, sans-serif';
            ctx.fillText(prof.name || 'PONPRO POS', 48, 76);

            ctx.fillStyle = textSub;
            ctx.font = '600 16px Inter, sans-serif';
            const periodLabel = state.reportDateFilter !== 'ALL' ? `Tanggal: ${state.reportDateFilter}` : 'Periode: Semua Transaksi';
            ctx.fillText(`OFFICIAL SALES REPORT • ${periodLabel}`, 48, 106);

            // Helper Draw Card
            const drawCard = (x, y, w, h) => {
                ctx.save();
                ctx.fillStyle = cardBg;
                ctx.strokeStyle = cardBorder;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.roundRect(x, y, w, h, 22);
                ctx.fill();
                ctx.stroke();
                ctx.restore();
            };

            // 2x2 KPI Cards
            const kpis = [
                { label: 'TOTAL OMZET BERSIH', val: formatCurrency(netRevenue), sub: `${filtered.length} transaksi sukses`, accent: textMain },
                { label: 'PROFIT BERSIH', val: formatCurrency(netProfit), sub: `Margin keuntungan ${margin}%`, accent: '#10b981' },
                { label: 'BARANG TERJUAL', val: `${totalQty} pcs`, sub: 'Total unit keluar', accent: '#0ea5e9' },
                { label: 'TOTAL MODAL (HPP)', val: formatCurrency(totalHpp), sub: 'Akumulasi HPP barang', accent: '#f59e0b' }
            ];

            kpis.forEach((k, i) => {
                const col = i % 2;
                const row = Math.floor(i / 2);
                const cx = 48 + col * 340;
                const cy = 140 + row * 165;
                drawCard(cx, cy, 324, 145);

                ctx.fillStyle = textSub;
                ctx.font = '700 13px Inter, sans-serif';
                ctx.fillText(k.label, cx + 24, cy + 38);

                ctx.fillStyle = k.accent;
                ctx.font = '800 28px "JetBrains Mono", monospace';
                ctx.fillText(k.val, cx + 24, cy + 84);

                ctx.fillStyle = textSub;
                ctx.font = '500 13px Inter, sans-serif';
                ctx.fillText(k.sub, cx + 24, cy + 116);
            });

            // Payment Breakdown Card
            drawCard(48, 480, W - 96, 200);
            ctx.fillStyle = textMain;
            ctx.font = '800 17px Inter, sans-serif';
            ctx.fillText('RINCIAN METODE PEMBAYARAN', 72, 520);

            Object.entries(payMap).forEach(([method, amt], idx) => {
                const rowY = 560 + idx * 38;
                ctx.fillStyle = textSub;
                ctx.font = '600 16px Inter, sans-serif';
                ctx.fillText(method, 72, rowY);

                ctx.fillStyle = textMain;
                ctx.font = '800 16px "JetBrains Mono", monospace';
                const valStr = formatCurrency(amt);
                const mWidth = ctx.measureText(valStr).width;
                ctx.fillText(valStr, W - 72 - mWidth, rowY);
            });

            // Top 3 Best Sellers Card
            drawCard(48, 700, W - 96, 220);
            ctx.fillStyle = textMain;
            ctx.font = '800 17px Inter, sans-serif';
            ctx.fillText('TOP 3 ARTIKEL TERLARIS', 72, 740);

            if (top3.length === 0) {
                ctx.fillStyle = textSub;
                ctx.font = '500 15px Inter, sans-serif';
                ctx.fillText('Belum ada data penjualan pada periode ini.', 72, 785);
            } else {
                top3.forEach(([artName, qty], idx) => {
                    const rowY = 782 + idx * 42;
                    ctx.fillStyle = textMain;
                    ctx.font = '700 15px Inter, sans-serif';
                    const truncated = artName.length > 36 ? artName.slice(0, 35) + '…' : artName;
                    ctx.fillText(`#${idx + 1}  ${truncated}`, 72, rowY);

                    ctx.fillStyle = '#10b981';
                    ctx.font = '800 15px "JetBrains Mono", monospace';
                    const qStr = `${qty} pcs`;
                    const qW = ctx.measureText(qStr).width;
                    ctx.fillText(qStr, W - 72 - qW, rowY);
                });
            }

            // Footer
            ctx.fillStyle = textSub;
            ctx.font = '600 13px "JetBrains Mono", monospace';
            ctx.fillText(`Dicetak: ${new Date().toLocaleString('id-ID')} • PONPRO POS`, 48, 975);

            // Clean Diagonal Watermark ("PONPRO POS")
            ctx.save();
            ctx.translate(W / 2, H / 2);
            ctx.rotate(-Math.PI / 6);
            ctx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.065)' : 'rgba(9, 9, 11, 0.06)';
            ctx.font = '900 42px Inter, sans-serif';
            ctx.textAlign = 'center';
            for (let wy = -520; wy <= 520; wy += 240) {
                for (let wx = -520; wx <= 520; wx += 420) {
                    ctx.fillText('PONPRO POS', wx, wy);
                }
            }
            ctx.restore();

            previewImg.src = canvas.toDataURL('image/png');
        }

