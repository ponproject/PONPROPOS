        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            const colorClass = type === 'error'
                ? 'bg-rose-600 text-white border-rose-500'
                : type === 'warning'
                    ? 'bg-amber-500 text-white border-amber-400'
                    : 'bg-zinc-900 dark:bg-white text-white dark:text-zinc-950 border-zinc-800 dark:border-zinc-200';
            toast.className = `${colorClass} border px-4 py-3 rounded-xl shadow-xl text-xs font-bold flex items-center gap-2 pointer-events-auto transition-all duration-300`;
            toast.innerHTML = `<i data-lucide="${type === 'error' ? 'alert-circle' : type === 'warning' ? 'alert-triangle' : 'check-circle-2'}" class="w-4 h-4 shrink-0"></i><span>${escapeHtml(message)}</span>`;
            container.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // =====================================================================
        // 4. POS CATALOG & CART MANAGEMENT
        // =====================================================================
        const SIZE_ORDER = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL', 'All Size'];

        function getSizeBadgeStyle(size, inCartQty, outOfStock) {
            if (outOfStock) {
                return 'bg-zinc-100 dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-400 line-through opacity-55 cursor-not-allowed';
            }
            if (inCartQty > 0) {
                return '!bg-zinc-900 !text-white dark:!bg-white dark:!text-zinc-950 border-zinc-900 dark:border-white shadow-xs';
            }
            const s = String(size || '').toUpperCase();
            if (s === 'XS' || s === 'S') return 'bg-sky-50/90 dark:bg-sky-950/50 border-sky-200/90 dark:border-sky-800 text-sky-900 dark:text-sky-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
            if (s === 'M') return 'bg-emerald-50/90 dark:bg-emerald-950/50 border-emerald-200/90 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
            if (s === 'L') return 'bg-amber-50/90 dark:bg-amber-950/50 border-amber-200/90 dark:border-amber-800 text-amber-900 dark:text-amber-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
            if (s === 'XL') return 'bg-purple-50/90 dark:bg-purple-950/50 border-purple-200/90 dark:border-purple-800 text-purple-900 dark:text-purple-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
            if (s === 'XXL' || s === 'XXXL') return 'bg-rose-50/90 dark:bg-rose-950/50 border-rose-200/90 dark:border-rose-800 text-rose-900 dark:text-rose-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
            return 'bg-zinc-100/90 dark:bg-zinc-800/90 border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 hover:!bg-zinc-900 hover:!text-white dark:hover:!bg-white dark:hover:!text-zinc-950';
        }

        function clearPosSearch() {
            const inp = document.getElementById('pos-search-input');
            if (inp) inp.value = '';
            renderPosCatalog();
        }

        function renderPosCatalog() {
            const listEl = document.getElementById('pos-catalog-list');
            const countEl = document.getElementById('pos-catalog-count');
            const clearBtn = document.getElementById('pos-clear-search');
            if (!listEl) return;

            const query = (document.getElementById('pos-search-input')?.value || '').trim().toLowerCase();
            const sizeFilter = document.getElementById('pos-size-filter')?.value || 'ALL';
            const hideOos = !!document.getElementById('pos-hide-oos')?.checked;

            if (clearBtn) clearBtn.classList.toggle('hidden', query.length === 0);

            const grouped = new Map();
            state.products.forEach(p => {
                if (query && !`${p.name} ${p.size}`.toLowerCase().includes(query)) return;
                if (sizeFilter !== 'ALL' && p.size.toLowerCase() !== sizeFilter.toLowerCase()) return;
                if (hideOos && p.stock <= 0) return;

                if (!grouped.has(p.name)) {
                    grouped.set(p.name, { name: p.name, price: p.price, variants: [], totalStock: 0 });
                }
                const g = grouped.get(p.name);
                g.variants.push(p);
                g.totalStock += Number(p.stock) || 0;
            });

            const articles = Array.from(grouped.values());
            if (countEl) countEl.textContent = `Menampilkan ${articles.length} artikel`;

            if (articles.length === 0) {
                listEl.innerHTML = `<div class="p-8 text-center text-xs text-zinc-400">Tidak ada artikel yang sesuai filter pencarian.</div>`;
                return;
            }

            listEl.innerHTML = articles.map(art => {
                art.variants.sort((a, b) => {
                    const ia = SIZE_ORDER.findIndex(s => s.toLowerCase() === a.size.toLowerCase());
                    const ib = SIZE_ORDER.findIndex(s => s.toLowerCase() === b.size.toLowerCase());
                    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
                });

                const sizeButtonsHtml = art.variants.map(v => {
                    const inCart = state.cart.find(c => c.id === v.id);
                    const inCartQty = inCart ? inCart.qty : 0;
                    const oos = v.stock <= 0;
                    const cls = getSizeBadgeStyle(v.size, inCartQty, oos);
                    return `
                        <button type="button" ${oos ? 'disabled' : `onclick="addToCart('${v.id}')"`}
                            class="px-2 py-1 rounded-lg border text-xs font-bold transition-all flex items-center gap-1 shrink-0 ${cls}">
                            <span>${escapeHtml(v.size)}</span>
                            <span class="font-mono text-[11px] opacity-80">(${v.stock})</span>
                            ${inCartQty > 0 ? `<span class="ml-0.5 px-1.5 py-0.2 rounded-full bg-emerald-500 text-white font-mono text-[10px] font-extrabold">${inCartQty}</span>` : ''}
                        </button>
                    `;
                }).join('');

                return `
                    <div class="px-3.5 py-2.5 hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-sm text-zinc-950 dark:text-white truncate">${escapeHtml(art.name)}</p>
                            <p class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 mt-0.5">
                                Sisa stok: <strong class="font-mono ${art.totalStock <= 3 ? 'text-amber-600 dark:text-amber-400' : 'text-zinc-800 dark:text-zinc-200'}">${art.totalStock} pcs</strong>
                            </p>
                        </div>
                        <div class="flex items-center gap-1 flex-nowrap overflow-x-auto py-0.5 shrink-0">
                            ${sizeButtonsHtml}
                        </div>
                        <div class="sm:w-24 text-left sm:text-right shrink-0">
                            <span class="font-mono font-extrabold text-sm text-zinc-950 dark:text-white">${formatCurrency(art.price)}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function addToCart(skuId) {
            const prod = state.products.find(p => p.id === skuId);
            if (!prod || prod.stock <= 0) {
                showToast('Stok barang habis!', 'error');
                return;
            }
            const existing = state.cart.find(c => c.id === skuId);
            if (existing) {
                if (existing.qty >= prod.stock) {
                    showToast(`Maksimal stok tersedia (${prod.stock} pcs)`, 'warning');
                    return;
                }
                existing.qty += 1;
            } else {
                state.cart.push({
                    id: prod.id,
                    name: prod.name,
                    size: prod.size,
                    hpp: Number(prod.hpp) || 0,
                    price: Number(prod.price) || 0,
                    qty: 1
                });
            }
            saveState();
            renderPosCatalog();
            renderCart();
        }

        function updateCartQty(skuId, delta) {
            const idx = state.cart.findIndex(c => c.id === skuId);
            if (idx === -1) return;
            const prod = state.products.find(p => p.id === skuId);
            const maxStock = prod ? prod.stock : 9999;

            const nextQty = state.cart[idx].qty + delta;
            if (nextQty <= 0) {
                state.cart.splice(idx, 1);
            } else if (nextQty > maxStock) {
                showToast(`Stok tersedia hanya ${maxStock} pcs`, 'warning');
                return;
            } else {
                state.cart[idx].qty = nextQty;
            }
            saveState();
            renderPosCatalog();
            renderCart();
        }

        function clearCart() {
            state.cart = [];
            if (!state.discountAutoSave) {
                state.discountValue = 0;
                state.discountName = '';
                const discInput = document.getElementById('cart-discount-value');
                if (discInput) discInput.value = 0;
            }
            const cashInp = document.getElementById('cash-tendered-input');
            if (cashInp) cashInp.value = '';
            saveState();
            renderPosCatalog();
            renderCart();
        }

        function getCartTotals() {
            const subtotal = state.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const rawDisc = Math.max(0, Number(state.discountValue) || 0);
            const discount = Math.min(subtotal, rawDisc);
            const discountName = (state.discountName || '').trim();
            const grandTotal = Math.max(0, subtotal - discount);
            return { subtotal, discount, discountName, grandTotal };
        }

        function renderCart() {
            const listEl = document.getElementById('cart-items-list');
            const badgeEl = document.getElementById('cart-badge-count');
            const pendingBadgeEl = document.getElementById('pending-badge-count');
            if (!listEl) return;

            const totalItems = state.cart.reduce((s, i) => s + i.qty, 0);
            if (badgeEl) badgeEl.textContent = totalItems;
            if (pendingBadgeEl) pendingBadgeEl.textContent = state.pendingOrders.length;

            if (state.cart.length === 0) {
                listEl.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center py-6 text-zinc-400">
                        <i data-lucide="shopping-bag" class="w-8 h-8 mb-2 opacity-30"></i>
                        <p class="text-xs font-semibold">Keranjang masih kosong</p>
                        <p class="text-[11px] mt-0.5">Klik ukuran pada daftar artikel di sebelah kiri.</p>
                    </div>
                `;
            } else {
                listEl.innerHTML = state.cart.map(item => `
                    <div class="p-2.5 rounded-xl bg-zinc-50/90 dark:bg-zinc-950/70 border border-zinc-200/80 dark:border-zinc-800 flex items-center justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <p class="font-bold text-xs text-zinc-900 dark:text-white truncate">${escapeHtml(item.name)}</p>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <span class="px-1.5 py-0.2 rounded bg-zinc-200/80 dark:bg-zinc-800 font-mono text-[10px] font-bold">${escapeHtml(item.size)}</span>
                                <span class="font-mono text-[11px] text-zinc-500">${formatCurrency(item.price)}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" onclick="updateCartQty('${item.id}', -1)" class="w-6 h-6 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-xs hover:bg-zinc-100">-</button>
                            <span class="w-6 text-center font-mono font-extrabold text-xs">${item.qty}</span>
                            <button type="button" onclick="updateCartQty('${item.id}', 1)" class="w-6 h-6 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-xs hover:bg-zinc-100">+</button>
                        </div>
                    </div>
                `).join('');
            }

            const { subtotal, discount, discountName, grandTotal } = getCartTotals();
            document.getElementById('summary-subtotal').textContent = formatCurrency(subtotal);
            const discLabelEl = document.getElementById('summary-discount-label');
            if (discLabelEl) {
                discLabelEl.textContent = discountName ? `Diskon (${discountName})` : 'Diskon';
            }
            document.getElementById('summary-discount').textContent = `- ${formatCurrency(discount)}`;
            document.getElementById('summary-grand-total').textContent = formatCurrency(grandTotal);

            renderQuickDiscountButtons();
            renderQuickCashButtons(grandTotal);
            calculateChange();
            lucide.createIcons();
        }

        function handleDiscountNameChange() {
            state.discountName = document.getElementById('cart-discount-name')?.value || '';
            saveState();
            const { discountName } = getCartTotals();
            const discLabelEl = document.getElementById('summary-discount-label');
            if (discLabelEl) {
                discLabelEl.textContent = discountName ? `Diskon (${discountName})` : 'Diskon';
            }
        }

        function handleDiscountChange() {
            const val = Math.max(0, Number(document.getElementById('cart-discount-value')?.value) || 0);
            state.discountValue = val;
            const presets = state.discountPresets[state.currency] || [];
            const matched = presets.find(p => Number(p.amount) === val);
            state.discountName = matched ? (matched.name || '') : '';
            saveState();
            renderCart();
        }

        function applyQuickDiscount(idx) {
            const presets = state.discountPresets[state.currency] || [];
            const preset = presets[idx];
            if (!preset) return;
            state.discountValue = Number(preset.amount) || 0;
            state.discountName = preset.name || '';
            const inp = document.getElementById('cart-discount-value');
            if (inp) inp.value = state.discountValue;
            saveState();
            renderCart();
        }

        function resetDiscount() {
            state.discountValue = 0;
            state.discountName = '';
            const inp = document.getElementById('cart-discount-value');
            if (inp) inp.value = 0;
            saveState();
            renderCart();
        }

        function toggleDiscountAutoSave() {
            state.discountAutoSave = !!document.getElementById('discount-autosave-toggle')?.checked;
            const badge = document.getElementById('discount-saved-badge');
            if (badge) badge.classList.toggle('hidden', !state.discountAutoSave);
            saveState();
        }

        function renderQuickDiscountButtons() {
            const container = document.getElementById('quick-discount-buttons');
            if (!container) return;
            const presets = state.discountPresets[state.currency] || [];
            container.innerHTML = presets.map((p, idx) => {
                const isActive = Number(state.discountValue) === Number(p.amount) && (state.discountName || '') === (p.name || '');
                const activeCls = isActive
                    ? 'border-zinc-900 dark:border-white aurora-pill text-zinc-950 dark:text-white shadow-2xs'
                    : 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-700 hover:border-zinc-900 dark:hover:border-white text-zinc-700 dark:text-zinc-200';
                return `
                    <button type="button" onclick="applyQuickDiscount(${idx})" class="px-2.5 py-1.5 rounded-lg border text-[11px] font-bold transition-all flex items-center gap-1.5 ${activeCls}">
                        ${p.name ? `<span>${escapeHtml(p.name)}</span><span class="opacity-40">•</span>` : ''}
                        <span class="font-mono">${formatCurrency(p.amount)}</span>
                    </button>
                `;
            }).join('');
        }

        // =====================================================================
        // 5. PAYMENT, CHECKOUT, PENDING ORDERS & DIGITAL RECEIPT
        // =====================================================================
        function selectPaymentMethod(method) {
            state.paymentMethod = method;
            document.querySelectorAll('.pay-method-btn').forEach(btn => {
                const isSelected = btn.textContent.trim() === method;
                if (isSelected) {
                    btn.className = 'pay-method-btn active py-2.5 px-2 rounded-xl border-2 border-zinc-900 dark:border-white aurora-pill text-zinc-950 dark:text-white text-xs font-bold flex flex-col items-center gap-1 transition-all shadow-sm';
