        function renderCekStok() {
            const grid = document.getElementById('cekstok-grid');
            if (!grid) return;

            const uniqueNames = new Set(state.products.map(p => p.name));
            const totalUnits = state.products.reduce((s, p) => s + (Number(p.stock) || 0), 0);
            const lowSkus = state.products.filter(p => p.stock > 0 && p.stock <= 3);
            const outSkus = state.products.filter(p => p.stock <= 0);

            document.getElementById('stat-total-articles').textContent = uniqueNames.size;
            document.getElementById('stat-total-units').textContent = `${totalUnits} pcs`;
            document.getElementById('stat-low-stock').textContent = `${lowSkus.length} SKU`;
            document.getElementById('stat-out-stock').textContent = `${outSkus.length} SKU`;

            const lowDrop = document.getElementById('dropdown-list-LOW');
            if (lowDrop) {
                lowDrop.innerHTML = lowSkus.length === 0
                    ? '<p class="text-amber-800/70 dark:text-amber-300/70 italic">Tidak ada SKU menipis.</p>'
                    : lowSkus.map(s => `<div class="flex justify-between font-medium text-amber-950 dark:text-amber-100"><span class="truncate pr-2">${escapeHtml(s.name)} (${escapeHtml(s.size)})</span><span class="font-mono font-bold shrink-0">${s.stock} pcs</span></div>`).join('');
            }

            const outDrop = document.getElementById('dropdown-list-OUT');
            if (outDrop) {
                outDrop.innerHTML = outSkus.length === 0
                    ? '<p class="text-rose-800/70 dark:text-rose-300/70 italic">Semua SKU masih memiliki stok.</p>'
                    : outSkus.map(s => `<div class="flex justify-between font-medium text-rose-950 dark:text-rose-100"><span class="truncate pr-2">${escapeHtml(s.name)} (${escapeHtml(s.size)})</span><span class="font-mono font-bold shrink-0">0 pcs</span></div>`).join('');
            }

            const query = (document.getElementById('cekstok-search')?.value || '').trim().toLowerCase();
            const grouped = new Map();
            state.products.forEach(p => {
                if (query && !`${p.name} ${p.size}`.toLowerCase().includes(query)) return;
                if (!grouped.has(p.name)) {
                    grouped.set(p.name, { name: p.name, price: p.price, variants: [], totalStock: 0 });
                }
                const g = grouped.get(p.name);
                g.variants.push(p);
                g.totalStock += Number(p.stock) || 0;
            });

            let articles = Array.from(grouped.values()).filter(art => {
                if (state.stockStatusFilter === 'LOW') return art.variants.some(v => v.stock > 0 && v.stock <= 3);
                if (state.stockStatusFilter === 'OUT') return art.variants.some(v => v.stock <= 0);
                return true;
            });

            const totalArticles = articles.length;
            const perPage = state.cekStokPerPage === 'ALL' ? Math.max(1, totalArticles) : state.cekStokPerPage;
            const totalPages = Math.max(1, Math.ceil(totalArticles / perPage));
            if (state.cekStokPage > totalPages) state.cekStokPage = totalPages;

            const startIdx = (state.cekStokPage - 1) * perPage;
            const pageItems = state.cekStokPerPage === 'ALL' ? articles : articles.slice(startIdx, startIdx + perPage);

            const infoEl = document.getElementById('cekstok-pagination-info');
            const indEl = document.getElementById('cekstok-page-indicator');
            const prevBtn = document.getElementById('cekstok-prev-page');
            const nextBtn = document.getElementById('cekstok-next-page');
            if (infoEl) infoEl.textContent = `Menampilkan ${pageItems.length} dari ${totalArticles} artikel`;
            if (indEl) indEl.textContent = `Hal ${state.cekStokPage} / ${totalPages}`;
            if (prevBtn) prevBtn.disabled = state.cekStokPage <= 1;
            if (nextBtn) nextBtn.disabled = state.cekStokPage >= totalPages;

            if (pageItems.length === 0) {
                grid.innerHTML = `<div class="col-span-full bg-white/80 dark:bg-zinc-900/80 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 text-center text-xs text-zinc-400">Tidak ada artikel yang cocok dengan filter.</div>`;
                return;
            }

            grid.innerHTML = pageItems.map(art => {
                art.variants.sort((a, b) => {
                    const ia = SIZE_ORDER.findIndex(s => s.toLowerCase() === a.size.toLowerCase());
                    const ib = SIZE_ORDER.findIndex(s => s.toLowerCase() === b.size.toLowerCase());
                    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
                });

                const pills = art.variants.map(v => {
                    const badgeCls = v.stock <= 0
                        ? 'bg-rose-50 dark:bg-rose-950/50 border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-400'
                        : v.stock <= 3
                            ? 'bg-amber-50 dark:bg-amber-950/50 border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300'
                            : 'bg-zinc-50 dark:bg-zinc-950 border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200';
                    return `<span class="px-2 py-0.5 rounded-md border text-[11px] font-bold ${badgeCls}">${escapeHtml(v.size)}: <span class="font-mono">${v.stock}</span></span>`;
                }).join('');

                return `
                    <div class="bg-white/90 dark:bg-zinc-900/90 p-3.5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-2xs flex flex-col justify-between gap-2.5">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-bold text-xs sm:text-sm text-zinc-950 dark:text-white leading-snug">${escapeHtml(art.name)}</h3>
                            <span class="px-2 py-0.5 rounded-full aurora-pill border border-zinc-200 dark:border-zinc-700 font-mono text-[10px] font-extrabold shrink-0">${art.totalStock} pcs</span>
                        </div>
                        <div class="flex flex-wrap gap-1.5">${pills}</div>
                    </div>
                `;
            }).join('');
        }

